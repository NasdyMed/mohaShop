# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# Random value of at least 32 characters used to sign authentication data.
AUTH_SECRET="replace-with-a-random-secret"

# Initial administrator account credentials.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-strong-password"

# Vercel Blob read/write access token.
BLOB_READ_WRITE_TOKEN="replace-with-vercel-blob-token"

# Upstash Redis REST API credentials.
UPSTASH_REDIS_REST_URL="https://example.upstash.io"
UPSTASH_REDIS_REST_TOKEN="replace-with-upstash-token"
