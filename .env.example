# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Random value used to sign authentication data. Generate it with: openssl rand -base64 32
AUTH_SECRET="<generate-random-secret>"

# Initial administrator account credentials.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-strong-password"

# Vercel Blob read/write access token.
BLOB_READ_WRITE_TOKEN="replace-with-vercel-blob-token"

# Upstash Redis REST API credentials.
UPSTASH_REDIS_REST_URL="https://example.upstash.io"
UPSTASH_REDIS_REST_TOKEN="replace-with-upstash-token"
